+
+bool Downloader::retry(Type type, const std::string& contentid)
+{
+    std::optional<DownloadItem> found;
+    {
+        ScopeLock _(_cond.get_mutex());
+        for (auto it = _history.begin(); it != _history.end(); ++it)
+            if (it->type == type && it->content == contentid && it->retry)
+            {
+                found = it->retry;
+                _history.erase(it);
+                break;
+            }
+    }
+    if (!found)
+        return false;
+    add(*found);
+    return true;
+}
+
+// the queue file holds the running download, the queued ones and the ones that failed because
+// of the network, so they continue after PKGj / the emulator is restarted
+void Downloader::save_queue_locked()
+{
+    std::string out;
+    const auto line = [&](const DownloadItem& d)
+    {
+        out += fmt::format(
+                "{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\n",
+                static_cast<int>(d.type),
+                one_line(d.name),
+                one_line(d.content),
+                one_line(d.url),
+                to_hex(d.rif),
+                to_hex(d.digest),
+                d.save_as_iso ? 1 : 0,
+                one_line(d.partition),
+                one_line(d.version));
+    };
+    if (!_current_download.content.empty())
+        line(_current_download);
+    for (const auto& d : _queue)
+        line(d);
+    for (const auto& d : _parked)
+        line(d);
+    try
+    {
+        if (out.empty())
+            pkgi_rm(QUEUE_FILE);
+        else
+        {
+            pkgi_mkdirs("ux0:pkgj");
+            pkgi_save(QUEUE_FILE, out.data(), static_cast<uint32_t>(out.size()));
+        }
+    }
+    catch (const std::exception& e)
+    {
+        LOG("Cannot save the download queue: %s", e.what());
+    }
+}
+
+void Downloader::resume_saved()
+{
+    std::vector<DownloadItem> restored;
+    try
+    {
+        if (pkgi_file_exists(QUEUE_FILE))
+        {
+            const auto data = pkgi_load(QUEUE_FILE);
+            std::string text(data.begin(), data.end());
+            size_t start = 0;
+            while (start < text.size())
+            {
+                auto end = text.find('\n', start);
+                if (end == std::string::npos)
+                    end = text.size();
+                const auto parts = split_tabs(text.substr(start, end - start));
+                start = end + 1;
+                if (parts.size() < 9 || parts[2].empty() || parts[3].empty())
+                    continue;
+                DownloadItem d;
+                d.type = static_cast<Type>(std::atoi(parts[0].c_str()));
+                d.name = parts[1];
+                d.content = parts[2];
+                d.url = parts[3];
+                d.rif = from_hex(parts[4]);
+                d.digest = from_hex(parts[5]);
+                d.save_as_iso = parts[6] == "1";
+                d.partition = parts[7];
+                d.version = parts[8];
+                restored.push_back(std::move(d));
+            }
+        }
+
+        // folders of finished / canceled downloads that stayed empty
+        std::vector<std::string> keep;
+        for (const auto& d : restored)
+            keep.push_back(d.content);
+        pkgi_mkdirs("ux0:pkgj");
+        for (const auto& name : pkgi_list_dir_contents("ux0:pkgj"))
+            if (std::find(keep.begin(), keep.end(), name) == keep.end())
+                prune_empty("ux0:pkgj/" + name);
+    }
+    catch (const std::exception& e)
+    {
+        LOG("Cannot restore the download queue: %s", e.what());
+    }
+
+    try
+    {
+        if (pkgi_file_exists(CANCEL_FILE))
+            pkgi_rm(CANCEL_FILE);
+    }
+    catch (const std::exception&)
+    {
+    }
+    {
+        ScopeLock _(_cond.get_mutex());
+        for (auto& d : restored)
+            _queue.push_back(std::move(d));
+        _ready = true;
+        LOG("Restored %d saved downloads", static_cast<int>(_queue.size()));
+    }
+    write_status("idle");
+    _cond.notify_one();
+}
+
+// status file for the Android service: state, name, progress, queue length, error text
+void Downloader::write_status(
+        const char* state, const std::string& msg, const char* kind)
+{
+    DownloadItem cur;
+    size_t queued;
+    {
+        ScopeLock _(_cond.get_mutex());
+        cur = _current_download;
+        queued = _queue.size();
+    }
+    const uint64_t offset = _download_offset.load();
+    const uint64_t total = _download_size.load();
+    const auto text = fmt::format(
+            "v=1\nstate={}\nname={}\ntype={}\npercent={}\ndone={}\n"
+            "total={}\nqueue={}\nattempt={}\nmax={}\nkind={}\nmsg={}\nraw={}\n",
+            state,
+            one_line(cur.name),
+            cur.content.empty() ? "" : type_to_string(cur.type),
+            total ? static_cast<int>(offset * 100 / total) : 0,
+            offset,
+            total,
+            queued,
+            _attempt.load(),
+            MAX_RETRIES,
+            kind,
+            one_line(msg),
+            one_line(_last_raw));
+    try
+    {
+        pkgi_save(STATUS_FILE, text.data(), static_cast<uint32_t>(text.size()));
+    }
+    catch (const std::exception&)
+    {
+    }
+}
+
+bool Downloader::check_cancel_request()
+{
+    if (!pkgi_file_exists(CANCEL_FILE))
+        return false;
+    try
+    {
+        pkgi_rm(CANCEL_FILE);
+    }
+    catch (const std::exception&)
+    {
+    }
+    LOG("Cancel requested from the notification");
+    ScopeLock _(_cond.get_mutex());
+    _queue.clear();
+    _parked.clear();
+    _cancel_current = true;
+    save_queue_locked();
+    return true;
+}
+
+void Downloader::maybe_write_status()
+{
+    const uint32_t now = pkgi_time_msec();
+    if (now - _last_status_ms.load() < 2000)
+        return;
+    _last_status_ms = now;
+    if (check_cancel_request())
+        return;
+    write_status("downloading");
+}
+
+bool Downloader::wait_retry(
+        const DownloadItem&,
+        int attempt,
+        uint32_t delay_sec,
+        const std::string& text)
+{
+    _attempt = attempt;
+    const auto status = fmt::format(
+            "Retry {}/{} in {}s: {}", attempt, MAX_RETRIES, delay_sec, text);
+    {
+        ScopeLock _(_cond.get_mutex());
+        _status = status;
+    }
+    LOG("%s", status.c_str());
+    write_status("retrying", text, "network");
+    uint32_t waited = 0;
+    while (waited < delay_sec * 1000)
+    {
+        if (_cancel_current || _dying)
+            return false;
+        pkgi_sleep(250);
+        waited += 250;
+        if (waited % 1000 == 0 && check_cancel_request())
+            return false;
+        if (waited % 2000 == 0)
+            write_status("retrying", text, "network");
+    }
+    {
+        ScopeLock _(_cond.get_mutex());
+        _status.clear();
+    }
+    return true;
 }
 
