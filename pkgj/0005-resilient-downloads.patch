+std::string one_line(std::string s)
+{
+    for (auto& c : s)
+        if (c == '\n' || c == '\r' || c == '\t')
+            c = ' ';
+    return s;
+}
+
+std::string to_hex(const std::vector<uint8_t>& v)
+{
+    static const char* digits = "0123456789abcdef";
+    std::string out;
+    for (auto b : v)
+    {
+        out += digits[b >> 4];
+        out += digits[b & 15];
+    }
+    return out;
+}
+
+std::vector<uint8_t> from_hex(const std::string& s)
+{
+    std::vector<uint8_t> out;
+    auto val = [](char c) -> int
+    {
+        if (c >= '0' && c <= '9')
+            return c - '0';
+        if (c >= 'a' && c <= 'f')
+            return c - 'a' + 10;
+        return -1;
+    };
+    for (size_t i = 0; i + 1 < s.size(); i += 2)
+    {
+        const int a = val(s[i]), b = val(s[i + 1]);
+        if (a < 0 || b < 0)
+            break;
+        out.push_back(static_cast<uint8_t>(a * 16 + b));
+    }
+    return out;
+}
+
+std::vector<std::string> split_tabs(const std::string& line)
+{
+    std::vector<std::string> parts;
+    size_t start = 0;
+    for (;;)
+    {
+        const auto pos = line.find('\t', start);
+        if (pos == std::string::npos)
+        {
+            parts.push_back(line.substr(start));
+            break;
+        }
+        parts.push_back(line.substr(start, pos - start));
+        start = pos + 1;
+    }
+    return parts;
+}
+
+// removes empty folders below path (and path itself); returns true if path is gone
+bool prune_empty(const std::string& path)
+{
+    try
+    {
+        if (pkgi_get_inode_type(path) != InodeType::Directory)
+            return false;
+        bool empty = true;
+        for (const auto& name : pkgi_list_dir_contents(path))
+        {
+            const auto child = path + "/" + name;
+            if (pkgi_get_inode_type(child) == InodeType::Directory &&
+                prune_empty(child))
+                continue;
+            empty = false;
+        }
+        if (!empty)
+            return false;
+        pkgi_delete_dir(path);
+        return true;
+    }
+    catch (const std::exception& e)
+    {
+        LOG("prune_empty(%s) failed: %s", path.c_str(), e.what());
+        return false;
+    }
+}
