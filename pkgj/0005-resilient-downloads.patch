+bool has(const std::string& s, const char* part)
+{
+    return s.find(part) != std::string::npos;
+}
+
+ErrorInfo classify_error(const std::string& raw)
+{
+    if (has(raw, "bad http status"))
+    {
+        const bool transient = has(raw, ": 5") || has(raw, ": 429") ||
+                               has(raw, ": 408");
+        if (has(raw, ": 404") || has(raw, ": 410"))
+            return {"server", false, "File not found on the server (HTTP 404/410), the link is dead"};
+        if (has(raw, ": 403") || has(raw, ": 401"))
+            return {"server", false, "Server refused access (HTTP 401/403)"};
+        return {"server",
+                transient,
+                transient ? "Server is busy or broken (" + raw + ")"
+                          : "Server error (" + raw + ")"};
+    }
+    if (has(raw, "failed to write") || has(raw, "cannot create file") ||
+        has(raw, "sceIoWrite") || has(raw, "sceIoOpen") ||
+        has(raw, "sceIoMkdir") || has(raw, "failed sceIo"))
+        return {"disk", false, "Disk error: no free space or no write access"};
+    if (has(raw, "integrity") || has(raw, "wrong pkg header") ||
+        has(raw, "zRIF content id") || has(raw, "corrupted") ||
+        has(raw, "invalid key type"))
+        return {"integrity", false, "The downloaded package is damaged or does not match"};
+    if (has(raw, "can't resume") || has(raw, "Resume data deleted"))
+        return {"network", true, "Saved progress was invalid, starting again"};
+    if (has(raw, "Host not found"))
+        return {"network", true, "Network error: host not found (no internet?)"};
+    if (has(raw, "Network timeout") || has(raw, "0x80431068"))
+        return {"network", true, "Network error: timeout"};
+    if (has(raw, "SSL"))
+        return {"network", true, "Network error: SSL / secure connection failed"};
+    if (has(raw, "HTTP") || has(raw, "Network") || has(raw, "0x8043") ||
+        has(raw, "0x8041") || has(raw, "0x80436"))
+        return {"network", true, "Network error: connection lost"};
+    if (has(raw, "install") || has(raw, "promot"))
+        return {"install", false, "Install failed: " + raw};
+    return {"other", false, raw};
+}
