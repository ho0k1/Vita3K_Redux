+namespace
+{
+struct DlcPreparation
+{
+    Downloader* downloader{nullptr};
+    std::shared_ptr<const std::vector<DbItem>> dlcs;
+    size_t next{0};
+    bool active{false};
+};
+DlcPreparation dlc_prep;
+}
+
+void pkgi_queue_dlcs_async(
+        Downloader* downloader,
+        std::shared_ptr<const std::vector<DbItem>> dlcs,
+        std::function<void()> start_game)
+{
+    if (dlc_prep.active)
+        return;
+    downloader->begin_batch();
+    if (start_game)
+        start_game();
+    dlc_prep.downloader = downloader;
+    dlc_prep.dlcs = std::move(dlcs);
+    dlc_prep.next = 0;
+    dlc_prep.active = true;
+    pkgi_dialog_message("Подготовка очереди: 0%", 0);
+}
+
+void pkgi_dlc_prepare_step()
+{
+    if (!dlc_prep.active)
+        return;
+
+    const auto& dlcs = *dlc_prep.dlcs;
+    const size_t total = dlcs.size();
+    // a couple of items per frame keeps the UI alive and the heap calm
+    for (int n = 0; n < 2 && dlc_prep.next < total; ++n, ++dlc_prep.next)
+    {
+        const auto& dlc = dlcs[dlc_prep.next];
+        if (pkgi_dlc_is_installed(dlc.content.c_str()) ||
+            dlc_prep.downloader->is_in_queue(Dlc, dlc.content))
+            continue;
+        pkgi_start_dlc_download(*dlc_prep.downloader, dlc);
+    }
+
+    if (dlc_prep.next < total)
+    {
+        pkgi_dialog_message(
+                fmt::format(
+                        "Подготовка очереди: {}%",
+                        static_cast<int>(dlc_prep.next * 100 / total))
+                        .c_str(),
+                0);
+        return;
+    }
+
+    dlc_prep.downloader->end_batch();
+    dlc_prep.active = false;
+    dlc_prep.dlcs.reset();
+    pkgi_dialog_close();
+}
+
