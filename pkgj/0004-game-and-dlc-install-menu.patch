+// DLCs of a game: the DLC list keeps the title id of the game it belongs to
+std::vector<DbItem> find_dlcs(const std::string& titleid)
+{
+    std::vector<DbItem> result;
+    try
+    {
+        TitleDatabase dlc_db(pkgi_get_config_folder());
+        dlc_db.reload(
+                ModeDlcs, DbFilterAll, SortByName, SortAscending, "", {});
+        for (uint32_t i = 0; i < dlc_db.count(); ++i)
+        {
+            DbItem* dlc = dlc_db.get(i);
+            if (dlc && dlc->titleid == titleid)
+                result.push_back(*dlc);
+        }
+    }
+    catch (const std::exception& e)
+    {
+        LOGF("DLC lookup failed: {}", e.what());
+    }
+    return result;
+}
+
+void queue_dlcs(Downloader* downloader, const std::vector<DbItem>& dlcs)
+{
+    for (const auto& dlc : dlcs)
+    {
+        if (pkgi_dlc_is_installed(dlc.content.c_str()) ||
+            downloader->is_in_queue(Dlc, dlc.content))
+            continue;
+        pkgi_start_dlc_download(*downloader, dlc);
+    }
+}
+}
+
