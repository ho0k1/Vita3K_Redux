+constexpr uint32_t STALL_SECONDS = 300;
+
+void Downloader::watchdog()
+{
+    uint64_t last_offset = 0;
+    uint32_t last_change = pkgi_time_msec();
+    while (!_dying)
+    {
+        pkgi_sleep(1000);
+        const uint32_t now = pkgi_time_msec();
+        const uint64_t offset = _download_offset.load();
+        if (!_transfer_active || offset != last_offset)
+        {
+            last_offset = offset;
+            last_change = now;
+            continue;
+        }
+        if (now - last_change < STALL_SECONDS * 1000)
+            continue;
+
+        ScopeLock _(_cond.get_mutex());
+        // only a stall while we really wait for the network (not while hashing or installing)
+        if (!_active_download || !_active_download->net_busy.load())
+            continue;
+        LOG_ERR("Download stalled for %u s at %llu bytes, restarting from the same place",
+                STALL_SECONDS,
+                static_cast<unsigned long long>(offset));
+        _stalled = true;
+        _active_download->abort_http();
+        last_change = now; // the restart gets a full period of its own
+    }
+}
