diff --git a/src/downloadsview.cpp b/src/downloadsview.cpp
new file mode 100644
index 0000000..24b708a
--- /dev/null
+++ b/src/downloadsview.cpp
@@ -0,0 +1,181 @@
+#include "downloadsview.hpp"
+
+#include <fmt/format.h>
+
+#include <algorithm>
+#include <string>
+#include <vector>
+
+#include "imgui.hpp"
+
+extern "C"
+{
+#include "style.h"
+}
+
+namespace
+{
+constexpr float ViewerW = VITA_WIDTH * 0.9f;
+constexpr float ViewerH = VITA_HEIGHT * 0.85f;
+
+std::string friendly_bytes(uint64_t size)
+{
+    if (size < 1000ULL * 1000)
+        return fmt::format("{:.0f} kB", static_cast<double>(size) / 1000.0);
+    if (size < 1000ULL * 1000 * 1000)
+        return fmt::format(
+                "{:.1f} MB", static_cast<double>(size) / 1000.0 / 1000.0);
+    return fmt::format(
+            "{:.2f} GB", static_cast<double>(size) / 1000.0 / 1000.0 / 1000.0);
+}
+
+struct Row
+{
+    std::string text;
+    ImVec4 color;
+    bool cancelable;
+    Type type;
+    std::string content;
+};
+}
+
+void DownloadsView::render(const pkgi_input& input)
+{
+    // ── Build the rows: running, queued, history (newest first) ──────────────
+    std::vector<Row> rows;
+    const ImVec4 white(1.f, 1.f, 1.f, 1.f);
+    const ImVec4 green(0.3f, 1.f, 0.5f, 1.f);
+    const ImVec4 yellow(1.f, 0.88f, 0.25f, 1.f);
+    const ImVec4 red(1.f, 0.35f, 0.35f, 1.f);
+    const ImVec4 dim(0.6f, 0.65f, 0.75f, 1.f);
+
+    const auto current = _downloader.get_current_download();
+    if (current)
+    {
+        uint64_t offset;
+        uint64_t size;
+        std::tie(offset, size) = _downloader.get_current_download_progress();
+        std::string progress = "starting...";
+        if (size > 0)
+            progress = fmt::format(
+                    "{}%  {} / {}",
+                    static_cast<int>(offset * 100 / size),
+                    friendly_bytes(offset),
+                    friendly_bytes(size));
+        rows.push_back(
+                {fmt::format(
+                         "[Downloading] {} ({})  {}",
+                         current->name,
+                         type_to_string(current->type),
+                         progress),
+                 green,
+                 true,
+                 current->type,
+                 current->content});
+    }
+
+    for (const auto& item : _downloader.get_queue())
+        rows.push_back(
+                {fmt::format(
+                         "[Queued] {} ({})",
+                         item.name,
+                         type_to_string(item.type)),
+                 yellow,
+                 true,
+                 item.type,
+                 item.content});
+
+    const auto history = _downloader.get_history();
+    for (auto it = history.rbegin(); it != history.rend(); ++it)
+    {
+        const bool ok = it->status == "Installed";
+        const bool failed = it->status.rfind("Failed", 0) == 0;
+        rows.push_back(
+                {fmt::format(
+                         "[{}] {} ({})",
+                         it->status,
+                         it->name,
+                         type_to_string(it->type)),
+                 ok ? white : (failed ? red : dim),
+                 false,
+                 it->type,
+                 it->content});
+    }
+
+    const int n = static_cast<int>(rows.size());
+
+    // ── Navigation (same repeat behaviour as the main list) ──────────────────
+    bool nav_step = false;
+    if ((input.active & PKGI_BUTTON_UP) && n > 0)
+    {
+        _selected = std::max(0, _selected - 1);
+        nav_step = true;
+    }
+    else if ((input.active & PKGI_BUTTON_DOWN) && n > 0)
+    {
+        _selected = std::min(n - 1, _selected + 1);
+        nav_step = true;
+    }
+    _selected = n == 0 ? 0 : std::max(0, std::min(_selected, n - 1));
+
+    // X cancels the selected running or queued download
+    if ((input.pressed & pkgi_ok_button()) && n > 0 &&
+        rows[_selected].cancelable)
+        _downloader.remove_from_queue(
+                rows[_selected].type, rows[_selected].content);
+
+    // ── Window ───────────────────────────────────────────────────────────────
+    ImGui::SetNextWindowPos(
+            ImVec2((VITA_WIDTH - ViewerW) / 2.f,
+                   (VITA_HEIGHT - ViewerH) / 2.f));
+    ImGui::SetNextWindowSize(ImVec2(ViewerW, ViewerH), 0);
+
+    ImGui::Begin(
+            "Downloads###downloadsview",
+            nullptr,
+            ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoMove |
+                    ImGuiWindowFlags_NoCollapse |
+                    ImGuiWindowFlags_NoSavedSettings |
+                    ImGuiWindowFlags_NoScrollbar |
+                    ImGuiWindowFlags_NoScrollWithMouse);
+
+    ImGui::Text("Downloads: %d", n);
+    ImGui::Separator();
+
+    const float footer_h =
+            ImGui::GetFrameHeightWithSpacing() + ImGui::GetStyle().ItemSpacing.y;
+
+    ImGui::BeginChild(
+            "##downloadrows",
+            ImVec2(0.f, -footer_h),
+            false,
+            ImGuiWindowFlags_NoNav);
+
+    if (n == 0)
+    {
+        ImGui::TextDisabled("(no downloads yet)");
+    }
+    else
+    {
+        for (int i = 0; i < n; ++i)
+        {
+            ImGui::PushID(i);
+            ImGui::PushStyleColor(ImGuiCol_Text, rows[i].color);
+            ImGui::Selectable(
+                    rows[i].text.c_str(),
+                    i == _selected,
+                    ImGuiSelectableFlags_Disabled);
+            ImGui::PopStyleColor();
+            if (i == _selected && nav_step)
+                ImGui::SetScrollHereY(0.5f);
+            ImGui::PopID();
+        }
+    }
+
+    ImGui::EndChild();
+
+    ImGui::Separator();
+    ImGui::TextDisabled("[Up/Down] select   [X] cancel download   [Circle] close");
+
+    ImGui::End();
+}
diff --git a/src/downloadsview.hpp b/src/downloadsview.hpp
new file mode 100644
index 0000000..d25a57f
--- /dev/null
+++ b/src/downloadsview.hpp
@@ -0,0 +1,31 @@
+#pragma once
+
+#include "downloader.hpp"
+#include "pkgi.hpp"
+
+// "Downloads" screen: the running download, the queue and the latest results.
+// Opened with the Square button in the game list.
+class DownloadsView
+{
+public:
+    explicit DownloadsView(Downloader& downloader) : _downloader(downloader)
+    {
+    }
+
+    // input: raw snapshot BEFORE pkgi.cpp zeros it.
+    void render(const pkgi_input& input);
+
+    bool is_closed() const
+    {
+        return _closed;
+    }
+    void close()
+    {
+        _closed = true;
+    }
+
+private:
+    Downloader& _downloader;
+    int _selected{0};
+    bool _closed{false};
+};
