// Vita3K Redux frame generation (VFG), step 1: copies the displayed game image into a private history image and
// builds a half resolution luma image used for motion search.
// Copyright (C) 2026 Vita3K team, GPLv2 or any later version.

#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D src;
layout(binding = 1, rgba8) uniform writeonly image2D dst_color;
layout(binding = 2, rgba8) uniform writeonly image2D dst_luma;

layout(push_constant) uniform Constants {
    // region of the source that is displayed, in uv coordinates: offset (xy) and size (zw)
    vec4 uv_rect;
    // size of the history image in pixels
    ivec2 size;
} c;

float luma(vec3 rgb) {
    return dot(rgb, vec3(0.299, 0.587, 0.114));
}

void main() {
    ivec2 half_pos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 half_size = (c.size + 1) / 2;
    if (half_pos.x >= half_size.x || half_pos.y >= half_size.y)
        return;

    float luma_sum = 0.0;
    for (int i = 0; i < 4; i++) {
        ivec2 pos = half_pos * 2 + ivec2(i & 1, i >> 1);
        // clamp so the odd last row/column repeats instead of reading outside
        ivec2 cpos = min(pos, c.size - 1);
        vec2 uv = c.uv_rect.xy + (vec2(cpos) + 0.5) / vec2(c.size) * c.uv_rect.zw;
        vec3 rgb = textureLod(src, uv, 0.0).rgb;
        luma_sum += luma(rgb);
        if (pos.x < c.size.x && pos.y < c.size.y)
            imageStore(dst_color, pos, vec4(rgb, 1.0));
    }
    imageStore(dst_luma, half_pos, vec4(luma_sum * 0.25, 0.0, 0.0, 1.0));
}
