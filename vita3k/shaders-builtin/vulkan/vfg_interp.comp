// Vita3K Redux frame generation (VFG), step 3: builds the in-between frame at time t (0 = previous, 1 = current).
// Both frames are warped along the block motion and blended. Where the two warped samples disagree (occlusions, wrong
// vectors) the result falls back to the nearest frame in time, which avoids ghosting.
// Copyright (C) 2026 Vita3K team, GPLv2 or any later version.

#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D prev_color;
layout(binding = 1) uniform sampler2D cur_color;
layout(binding = 2) uniform sampler2D flow;
layout(binding = 3, rgba8) uniform writeonly image2D dst;

layout(push_constant) uniform Constants {
    ivec2 size;
    float t;
} c;

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= c.size.x || pos.y >= c.size.y)
        return;

    vec2 uv = (vec2(pos) + 0.5) / vec2(c.size);
    // flow is in half resolution luma pixels, the colors are in full resolution pixels
    vec2 mv = texture(flow, uv).xy * 2.0;
    vec2 inv_size = 1.0 / vec2(c.size);

    vec3 a = texture(prev_color, uv + mv * c.t * inv_size).rgb;
    vec3 b = texture(cur_color, uv - mv * (1.0 - c.t) * inv_size).rgb;
    vec3 warped = mix(a, b, c.t);

    vec3 nearest = c.t < 0.5 ? texture(prev_color, uv).rgb : texture(cur_color, uv).rgb;
    float diff = max(abs(a.r - b.r), max(abs(a.g - b.g), abs(a.b - b.b)));
    float w = smoothstep(0.08, 0.25, diff);

    imageStore(dst, pos, vec4(mix(warped, nearest, w), 1.0));
}
