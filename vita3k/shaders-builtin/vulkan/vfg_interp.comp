// Vita3K Redux frame generation (VFG), step 3: builds the in-between frame at time t (0 = previous, 1 = current).
// Both frames are warped along the block motion and blended. Where the two warped samples disagree (occlusions, wrong
// vectors) the result falls back to the nearest frame in time, which avoids ghosting.
// Copyright (C) 2026 Vita3K team, GPLv2 or any later version.

#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D prev_color;
layout(binding = 1) uniform sampler2D cur_color;
layout(binding = 2) uniform sampler2D flow;
layout(binding = 3, rgba8) uniform writeonly image2D dst;
layout(binding = 4) uniform sampler2D scene;

layout(push_constant) uniform Constants {
    ivec2 size;
    float t;
} c;

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= c.size.x || pos.y >= c.size.y)
        return;

    vec2 uv = (vec2(pos) + 0.5) / vec2(c.size);

    // scene change: no motion can explain the difference between the two frames, show the new frame as it is
    vec2 scene_error = texelFetch(scene, ivec2(0), 0).xy;
    if (scene_error.x > 0.12 && scene_error.y > 0.12) {
        imageStore(dst, pos, vec4(texture(cur_color, uv).rgb, 1.0));
        return;
    }
    vec2 inv_size = 1.0 / vec2(c.size);
    // flow is in half resolution luma pixels, the colors are in full resolution pixels
    vec2 own_mv = texture(flow, uv).xy * 2.0;

    vec3 a = texture(prev_color, uv + own_mv * c.t * inv_size).rgb;
    vec3 b = texture(cur_color, uv - own_mv * (1.0 - c.t) * inv_size).rgb;
    float best_diff = max(abs(a.r - b.r), max(abs(a.g - b.g), abs(a.b - b.b)));
    vec3 best_a = a;
    vec3 best_b = b;

    // The two warped samples disagree: the pixel is probably (dis)occluded, the block vector belongs to the object in
    // front, not to the background that appears or disappears here. Try the vector of no motion and the vectors of the
    // neighbour blocks (the background usually is one of them) and keep the pair that agrees best.
    if (best_diff > 0.04) {
        ivec2 flow_size = textureSize(flow, 0);
        ivec2 block = clamp(pos / 16, ivec2(0), flow_size - 1);
        const ivec2 offsets[5] = ivec2[5](ivec2(0), ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1));
        for (int i = 0; i < 5; i++) {
            vec2 mv = i == 0 ? vec2(0.0) : texelFetch(flow, clamp(block + offsets[i], ivec2(0), flow_size - 1), 0).xy * 2.0;
            vec3 pa = texture(prev_color, uv + mv * c.t * inv_size).rgb;
            vec3 pb = texture(cur_color, uv - mv * (1.0 - c.t) * inv_size).rgb;
            float d = max(abs(pa.r - pb.r), max(abs(pa.g - pb.g), abs(pa.b - pb.b)));
            if (d < best_diff) {
                best_diff = d;
                best_a = pa;
                best_b = pb;
            }
        }
    }

    vec3 warped = mix(best_a, best_b, c.t);
    vec3 nearest = c.t < 0.5 ? texture(prev_color, uv).rgb : texture(cur_color, uv).rgb;
    float w = smoothstep(0.08, 0.25, best_diff);

    imageStore(dst, pos, vec4(mix(warped, nearest, w), 1.0));
}
